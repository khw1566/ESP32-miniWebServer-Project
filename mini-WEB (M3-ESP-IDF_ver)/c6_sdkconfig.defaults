# Companion image for esp_hosted 1.4.1 / esp_wifi_remote 0.14.0.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESP_SDIO_HOST_INTERFACE=y
CONFIG_ESP_SDIO_GPIO_RESET=-1
CONFIG_ESP_SDIO_DEFAULT_SPEED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# No Bluetooth is required by the web server.
# CONFIG_BT_ENABLED is not set
# CONFIG_ESP_PKT_STATS is not set
