# Synchronous eSpeak runs with caches enabled and never in an ISR. Its large
# zero-initialized synthesis tables do not need internal/DMA RAM.
[scheme:m3_espeak_psram]
entries:
    bss -> extern_ram
    common -> extern_ram

[mapping:m3_espeak_psram]
archive: libespeak_ng.a
entries:
    * (m3_espeak_psram)
