menu "Mini WebServer M3"
    config M3_WEB_ASSET_LIMIT_KB
        int "PSRAM budget for SD Main WebFlie web files (KiB)"
        range 256 16384
        default 8192
    config M3_WEB_ASSET_MAX_FILES
        int "Maximum preloaded Main WebFlie files"
        range 8 4096
        default 512
    config M3_TOUCH_RESET
        int "GT911 reset GPIO (-1 if unconnected)"
        range -1 54
        default 3
    config M3_TOUCH_MIRROR_X
        bool "Mirror touchscreen X"
        default n
    config M3_TOUCH_MIRROR_Y
        bool "Mirror touchscreen Y"
        default n
endmenu

menu "Mini WEB automatic cloud connection"
    config MINI_WEB_RELAY_URL
        string "Factory cloud relay HTTPS endpoint"
        default "https://relay.audreaming.com"
    config MINI_WEB_PUBLIC_DOMAIN
        string "Factory public domain"
        default "audreaming.com"
    config MINI_WEB_PUBLIC_HOST
        string "Optional factory hostname"
        default ""
        help
            Empty uses m3-<board MAC>.PUBLIC_DOMAIN. Configure the matching
            Worker domain before shipment. Device token comes from factory
            NVS, never Wi-Fi UI.
endmenu
