    "function sdControls(){var blocked=sdBusy||g_uploading||g_collecting||fileBulkBusy;var zone=document.getElementById('sdDropZone');zone.setAttribute('aria-disabled',String(blocked||(!g_adminPw&&!g_adminSession)));zone.setAttribute('aria-busy',String(blocked));if(blocked||(!g_adminPw&&!g_adminSession))zone.classList.remove('dv');['sdRefresh','sdSelect','sdNewText','sdUp','sdPrev','sdNext','sdInput'].forEach(function(id){document.getElementById(id).disabled=blocked||(!g_adminPw&&!g_adminSession);});document.getElementById('sdPrev').disabled=blocked||(!g_adminPw&&!g_adminSession)||sdOffset===0;document.getElementById('sdNext').disabled=blocked||(!g_adminPw&&!g_adminSession)||sdOffset+sdPageSize>=sdCount;document.getElementById('sdUp').disabled=blocked||(!g_adminPw&&!g_adminSession)||sdFolder==='/';sdSelectionControls();}\n" \
