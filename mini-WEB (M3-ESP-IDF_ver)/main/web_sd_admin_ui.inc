    "function sdSend(file,version){return new Promise(function(resolve,reject){var xhr=new XMLHttpRequest();xhr.open(version?'PUT':'POST',sdUrl(sdPath(file.name)));if(version)xhr.setRequestHeader('If-Match',version);xhr.timeout=180000;xhr.setRequestHeader('X-Admin-Password',g_adminPw);xhr.upload.onprogress=function(e){if(e.lengthComputable)document.getElementById('sdProgress').value=Math.round(e.loaded/e.total*100);};xhr.onload=function(){if(xhr.status>=200&&xhr.status<300)resolve();else{var error=new Error(xhr.responseText||'업로드 실패');error.status=xhr.status;reject(error);}};xhr.onerror=function(){reject(new Error('전송 연결이 끊겼습니다.'));};xhr.ontimeout=function(){reject(new Error('업로드 시간이 초과되었습니다.'));};xhr.send(file);});}\n" \
