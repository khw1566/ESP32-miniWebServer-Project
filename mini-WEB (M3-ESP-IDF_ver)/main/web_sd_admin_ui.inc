    "async function sdRefresh(){if(sdBusy||g_uploading||g_collecting||fileBulkBusy||(!g_adminPw&&!g_adminSession))return;sdBusy=true;sdControls();var body=document.getElementById('sdFiles');body.textContent='';try{var r=await sdRequest(sdFolder,{},'&offset='+sdOffset),d=await r.json();sdPageSize=d.page_size;sdCount=d.count;if(sdOffset>=sdCount&&sdOffset>0){sdOffset=Math.max(0,Math.floor((sdCount-1)/sdPageSize)*sdPageSize);sdBusy=false;return await sdRefresh();}sdVisible=d.files;if(sdSelectionFolder!==sdFolder){sdSelection.clear();sdSelectionFolder=sdFolder;}var free=Math.max(0,d.total-d.used),pct=d.total?Math.round(d.used/d.total*100):0;document.getElementById('sdCapacity').textContent='인식됨 · 사용 '+fmtB(d.used)+' / 전체 '+fmtB(d.total)+' · 남음 '+fmtB(free)+' ('+pct+'% 사용)';var bar=document.getElementById('sdUsageBar');bar.style.width=pct+'%';sdChart(d.total,d.used);bar.setAttribute('aria-label','SD카드 '+pct+'% 사용');document.getElementById('sdFolder').textContent=sdFolder;document.getElementById('sdPage').textContent=sdCount?Math.floor(sdOffset/sdPageSize)+1+' / '+Math.ceil(sdCount/sdPageSize):'0개';d.files.forEach(function(f){var row=body.insertRow(),selectCell=row.insertCell();if(!f.directory){var check=document.createElement('input');check.type='checkbox';check.checked=sdSelection.has(f.name);check.setAttribute('aria-label',f.name+' 선택');check.onchange=function(){if(sdBusy||g_uploading||g_collecting){check.checked=sdSelection.has(f.name);return;}if(check.checked)sdSelection.add(f.name);else sdSelection.delete(f.name);sdSelectionControls();};selectCell.appendChild(check);}row.insertCell().textContent=f.name;row.insertCell().textContent=f.directory?'폴더':fmtB(f.size);var cell=row.insertCell();function btn(label,action){var b=document.createElement('button');b.className='btn btn-s btn-sm';b.textContent=label;b.onclick=function(){if(!sdBusy&&!fileBulkBusy&&!g_uploading&&!g_collecting)action();};cell.appendChild(b);}if(f.directory)btn('열기',function(){sdFolder=sdPath(f.name);s