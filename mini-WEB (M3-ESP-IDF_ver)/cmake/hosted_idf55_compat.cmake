# esp_hosted 1.4.1 predates the wifi_sta_config_t reserved-field rename in
# IDF 5.5.5. Reserved bits are not application settings and must stay zero.
# Compile generated copies, retaining the downloaded component/hash unchanged.
function(m3_hosted_idf55_compat)
    idf_component_get_property(hosted_dir espressif__esp_hosted COMPONENT_DIR)
    idf_component_get_property(hosted_target espressif__esp_hosted COMPONENT_LIB)
    set(wifi_header "$ENV{IDF_PATH}/components/esp_wifi/include/esp_wifi_types_generic.h")
    if(NOT EXISTS "${wifi_header}")
        message(FATAL_ERROR "M3 Hosted compatibility: Wi-Fi SDK header not found")
    endif()
    file(READ "${wifi_header}" wifi_types)
    if(NOT wifi_types MATCHES "uint32_t[ \t]+reserved1[ \t]*:"
       OR NOT wifi_types MATCHES "uint32_t[ \t]+reserved2[ \t]*:")
        return()
    endif()
    file(READ "${hosted_dir}/idf_component.yml" hosted_manifest)
    if(NOT hosted_manifest MATCHES "version:[ \t]*[\"']?1\\.4\\.1[\"']?([\r\n]|$)")
        message(FATAL_ERROR "M3 Hosted compatibility is scoped to esp_hosted 1.4.1")
    endif()
    set(output_dir "${CMAKE_BINARY_DIR}/m3_hosted_compat")
    file(MAKE_DIRECTORY "${output_dir}")
    get_target_property(original_sources "${hosted_target}" SOURCES)
    set(replacement_sources)
    set(replaced_count 0)
    foreach(source IN LISTS original_sources)
        get_filename_component(basename "${source}" NAME)
        if(basename STREQUAL "rpc_req.c" OR basename STREQUAL "rpc_rsp.c")
            set(original "${hosted_dir}/host/drivers/rpc/core/${basename}")
            file(READ "${original}" contents)
            if(basename STREQUAL "rpc_req.c")
                set(old_sta "WIFI_CONFIG_STA_SET_RESERVED_VAL(p_a_sta->reserved, p_c_sta->bitmask);")
                set(old_he "WIFI_HE_STA_SET_RESERVED_VAL(p_a_sta->he_reserved, p_c_sta->he_bitmask);")
                foreach(expected IN ITEMS "${old_sta}" "${old_he}")
                    string(FIND "${contents}" "${expected}" found)
                    if(found EQUAL -1)
                        message(FATAL_ERROR "Unexpected esp_hosted 1.4.1 rpc_req.c; refusing partial compatibility patch")
                    endif()
                endforeach()
                string(REPLACE "${old_sta}" "/* M3 IDF5.5: STA reserved wire bits remain zero. */" contents "${contents}")
                string(REPLACE "${old_he}" "/* M3 IDF5.5: HE reserved wire bits remain zero. */" contents "${contents}")
            else()
                set(old_rsp "p_a_sta->reserved = WIFI_CONFIG_STA_GET_RESERVED_VAL(p_c_sta->bitmask);")
                string(FIND "${contents}" "${old_rsp}" found)
                if(found EQUAL -1)
                    message(FATAL_ERROR "Unexpected esp_hosted 1.4.1 rpc_rsp.c; refusing partial compatibility patch")
                endif()
                string(REPLACE "${old_rsp}" "/* M3 IDF5.5: do not import reserved wire bits into SDK config. */" contents "${contents}")
            endif()
            set(generated "${output_dir}/${basename}")
            # configure_file avoids rewriting an unchanged generated source.
            file(WRITE "${generated}.in" "${contents}")
            configure_file("${generated}.in" "${generated}" COPYONLY)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${wifi_header}")
            list(APPEND replacement_sources "${generated}")
            math(EXPR replaced_count "${replaced_count} + 1")
        else()
            list(APPEND replacement_sources "${source}")
        endif()
    endforeach()
    if(NOT replaced_count EQUAL 2)
        message(FATAL_ERROR "M3 Hosted compatibility expected exactly two RPC sources")
    endif()
    set_property(TARGET "${hosted_target}" PROPERTY SOURCES "${replacement_sources}")
    message(STATUS "M3: esp_hosted 1.4.1 / IDF 5.5 reserved-bit compatibility enabled")
endfunction()
