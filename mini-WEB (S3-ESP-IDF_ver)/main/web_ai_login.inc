static const char HTML_AI_LOGIN[] =
    "<!DOCTYPE html>"
    "<html lang=\"ko\">"
    "<head>"
    "<meta charset=\"utf-8\">"
    "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
    "<title>AI 어시스턴트 로그인</title>"
    "<style>\n"
    "\n"
    ":root{color-scheme:light;--bg:#f4f5f7;--surface:#ffffff;--raised:#eef0f3;--text:#20252c;--muted:#69727d;--line:#d7dce3;--blue:#2563eb;--blue-hover:#1d4ed8;--on-blue:#ffffff;--overlay:rgba(0,0,0,.45)}:root[data-theme=\"dark\"]{color-scheme:dark;--bg:#101215;--surface:#181b20;--raised:#242830;--text:#e7eaf0;--muted:#a0a8b4;--line:#383f49;--blue:#3b82f6;--blue-hover:#2563eb;--on-blue:#ffffff;--overlay:rgba(0,0,0,.65)}\n"
    "*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,sans-serif;min-height:100dvh;display:grid;place-items:center;padding:20px}.card{width:100%;max-width:430px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:24px}h1{font-size:22px;margin:0 0 12px}p{font-size:13px;color:var(--muted);line-height:1.7}label{display:block;font-size:13px;margin:20px 0 8px}input,button{font:inherit;width:100%;padding:12px;border-radius:8px;border:1px solid var(--line)}input{background:var(--bg);color:var(--text)}button{background:var(--blue);color:#fff;border:0;cursor:pointer;margin-top:14px}button:disabled{opacity:.6}a{color:var(--blue)}#loginStatus{white-space:pre-line;overflow-wrap:anywhere}\n"
    ".password-row{display:flex;align-items:center;gap:8px}.password-row input{flex:1;min-width:0}.password-row button{flex:none;margin:0;padding:12px}\n"
    "</style>"
    "<script>(function(){var t='';try{t=localStorage.getItem('mw_ui_theme')||'';}catch(e){}if(t!=='light'&&t!=='dark')t=window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';document.documentElement.dataset.theme=t;})();</script>"
    "</head>"
    "<body>"
    "<main class=\"card\">"
    "<button id=\"aiThemeToggle\" type=\"button\" onclick=\"toggleAiTheme()\" aria-pressed=\"false\" style=\"width:auto;background:var(--raised);color:var(--text);border:1px solid var(--line);margin:0 0 16px;\">다크 모드</button>"
    "<h1>AI 어시스턴트</h1>"
    "<p>관리자 비밀번호를 입력해야 대화와 파일 관리 도구를 사용할 수 있습니다. 초기 비밀번호는 00000000입니다. 관리자에서 변경한 비밀번호도 사용할 수 있습니다.</p>"
    "<form id=\"loginForm\">"
    "<label for=\"aiLoginPassword\">관리자 비밀번호</label>"
    "<div class=\"password-row\">"
    "<input id=\"aiLoginPassword\" type=\"password\" autocomplete=\"current-password\" placeholder=\"초기 비밀번호: 00000000\" maxlength=\"63\" required>"
    "<button type=\"button\" onclick=\"togglePasswordView('aiLoginPassword',this)\" aria-pressed=\"false\" aria-label=\"비밀번호 보기\" style=\"width:auto;margin:0;white-space:nowrap;background:var(--raised);color:var(--text);border:1px solid var(--line);\">보기</button>"
    "</div>"
    "<button id=\"loginButton\">로그인</button>"
    "</form>"
    "<p id=\"authFailureStats\" data-auth-failures role=\"status\" aria-live=\"polite\">실패 횟수 확인 중...</p>"
    "<p id=\"loginStatus\" role=\"status\" aria-live=\"polite\">"
    "</p>"
    "<p>세션은 30분 후 만료되며 새로고침·재접속 시 다시 로그인합니다. 로그인 실패 5회 시 60초 동안 제한됩니다.</p>"
    "<p>현재 보드 접속은 HTTP입니다. 비밀번호와 키 등록은 신뢰하는 개인 Wi-Fi에서 진행하세요. 외부 공개용 HTTPS는 별도 구성이 필요합니다.</p>"
    "<a href=\"/admin\">관리자 설정에서 비밀번호 변경</a>"
    "</main>"
    "<script>\n"
    "'use strict';\n"
    "function uiErrorText(e){if(e&&e.name==='SyntaxError')return '서버 응답 형식이 올바르지 않습니다. 펌웨어 적용 상태를 확인하세요.';if(e&&e.name==='TypeError')return '보드에 연결하지 못했습니다. 네트워크 연결을 확인하세요.';return e&&e.message?e.message:'처리에 실패했습니다. 다시 시도하세요.';}\n"
    "\n"
    "try{sessionStorage.removeItem('mw_admin_auth');localStorage.removeItem('mw_gemini_key');}catch(e){}\n"
    "\n"
    "function updateAiThemeButton(){var b=document.getElementById('aiThemeToggle');if(!b)return;var dark=document.documentElement.dataset.theme==='dark';b.textContent=dark?'일반 모드':'다크 모드';b.setAttribute('aria-pressed',String(dark));}\n"
    "function toggleAiTheme(){var t=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=t;try{localStorage.setItem('mw_ui_theme',t);}catch(e){}updateAiThemeButton();}\n"
    "updateAiThemeButton();\n"
    "\n"
    "var g_authDeadline=0,g_authSnapshot=null;\n"
    "function togglePasswordView(id,button){var input=document.getElementById(id),show=input.type==='password';input.type=show?'text':'password';button.textContent=show?'숨기기':'보기';button.setAttribute('aria-pressed',String(show));button.setAttribute('aria-label',show?'비밀번호 숨기기':'비밀번호 보기');}\n"
    "function renderAuthFailures(){\n"
    " var boxes=document.querySelectorAll('[data-auth-failures]'),box=boxes[0],btn=document.getElementById('loginButton');if(!box||!g_authSnapshot)return;\n"
    " var d=g_authSnapshot,retry=Math.max(0,Math.ceil((g_authDeadline-Date.now())/1000));\n"
    " var message='현재 실패 '+(retry?5:(d.retry_after?0:d.failed_attempts))+' / 5회 · 누적 실패 '+d.failed_total+'회'+(retry?' · '+retry+'초 후 재시도':'')+(d.record_saved?'':' · 기록 저장에 실패했습니다. 누적 횟수는 현재 메모리 값입니다.');\n"
    " boxes.forEach(function(e){e.textContent=message;});\n"
    " if(btn)btn.disabled=retry>0||btn.dataset.authBusy==='true';\n"
    "}\n"
    "function acceptAuthFailures(d){if(typeof d.failed_total!=='number')return;g_authSnapshot=d;g_authDeadline=Date.now()+(d.retry_after||0)*1000;renderAuthFailures();}\n"
    "async function refreshAuthFailures(){try{var r=await fetch('/api/auth/status',{cache:'no-store'});if(!r.ok)throw Error();acceptAuthFailures(await r.json());}catch(e){var b=document.getElementById('authFailureStats');if(b&&!g_authSnapshot)b.textContent='로그인 실패 횟수를 불러오지 못했습니다.';}}\n"
    "refreshAuthFailures();setInterval(renderAuthFailures,1000);window.addEventListener('focus',refreshAuthFailures);\n"
    "\n"
    "document.getElementById('loginForm').addEventListener('submit',async function(e){\n"
    " e.preventDefault();var btn=document.getElementById('loginButton'),status=document.getElementById('loginStatus'),input=document.getElementById('aiLoginPassword');btn.disabled=true;btn.dataset.authBusy='true';status.textContent='비밀번호 확인 중...';var token='';\n"
    " try{\n"
    "  var r=await fetch('/api/ai/login',{method:'POST',headers:{'Content-Type':'application/json'},cache:'no-store',body:JSON.stringify({password:input.value})});var d=await r.json();acceptAuthFailures(d);if(!r.ok||!d.ok)throw Error(d.error||'로그인 실패');input.value='';token=d.token;\n"
    "  r=await fetch('/api/ai/studio',{headers:{Authorization:'Bearer '+token},cache:'no-store'});if(!r.ok)throw Error('AI 화면을 열지 못했습니다.');\n"
    "  var html=await r.text(),openTag='<'+'script>',closeTag='<'+'/script>';\n"
    "  html=html.replace(openTag,openTag+'window.g_aiToken='+JSON.stringify(token)+';'+closeTag+openTag);\n"
    "  document.open();document.write(html);document.close();\n"
    " }catch(err){if(token)fetch('/api/ai/logout',{method:'POST',headers:{Authorization:'Bearer '+token}}).catch(function(){});status.textContent=uiErrorText(err);btn.dataset.authBusy='false';btn.disabled=false;await refreshAuthFailures();renderAuthFailures();}\n"
    "});\n"
    "</script>"
    "</body>"
    "</html>";
