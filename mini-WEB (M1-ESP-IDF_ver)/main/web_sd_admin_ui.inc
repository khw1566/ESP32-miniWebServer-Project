#define SD_ADMIN_HTML \
    "<div class=\"card\"><div class=\"card-hd\"><span>SD카드 파일 관리</span><button id=\"sdRefresh\" class=\"btn btn-s btn-sm\" onclick=\"sdRefresh()\">새로고침</button></div><div class=\"storage-summary\" id=\"sdCapacity\">로그인 후 SD카드를 조회합니다.</div><div class=\"pbar-bg\"><div id=\"sdUsageBar\" class=\"pbar-fill\" style=\"width:0%;background:var(--blue)\"></div></div><div class=\"storage-toolbar\"><button class=\"btn btn-s btn-sm\" id=\"sdUp\" onclick=\"sdParent()\">상위 폴더</button><button class=\"btn btn-p btn-sm\" id=\"sdSelect\" onclick=\"document.getElementById('sdInput').click()\">파일 넣기</button><input id=\"sdInput\" type=\"file\" multiple hidden onchange=\"sdUpload(this.files)\"></div><div id=\"sdFolder\" class=\"storage-path\">/</div><p class=\"storage-note\">현재 폴더에 저장합니다. 파일당 최대 8 MiB이며 같은 이름은 덮어쓰지 않습니다. 웹페이지는 루트에 index.html, 이미지·영상·음악은 media 폴더에 넣으세요.</p><progress id=\"sdProgress\" max=\"100\" value=\"0\" style=\"width:100%;display:none\"></progress><div id=\"sdMessage\" role=\"status\" aria-live=\"polite\" class=\"storage-status\"></div><div style=\"overflow-x:auto\"><table class=\"storage-table\"><thead><tr><th>파일·폴더</th><th>용량</th><th>작업</th></tr></thead><tbody id=\"sdFiles\"></tbody></table></div><div class=\"storage-pages\"><button id=\"sdPrev\" class=\"btn btn-s btn-sm\" onclick=\"sdOffset=Math.max(0,sdOffset-sdPageSize);sdRefresh()\">이전</button><span id=\"sdPage\"></span><button id=\"sdNext\" class=\"btn btn-s btn-sm\" onclick=\"sdOffset+=sdPageSize;sdRefresh()\">다음</button></div></div>\n"
#define SD_ADMIN_SCRIPT \
    "\n" \
    "var sdFolder='/',sdOffset=0,sdPageSize=3,sdCount=0,sdBusy=false;\n" \
    "function sdUrl(path,extra){return '/api/sd/files?path='+encodeURIComponent(path)+(extra||'');}\n" \
    "function sdPath(name){return (sdFolder==='/'?'':sdFolder)+'/'+name;}\n" \
    "function sdMessage(text){document.getElementById('sdMessage').textContent=text;}\n" \
    "function sdControls(){['sdRefresh','sdSelect','sdUp','sdPrev','sdNext','sdInput'].forEach(function(id){document.getElementById(id).disabled=sdBusy||!g_adminPw;});document.getElementById('sdPrev').disabled=sdBusy||!g_adminPw||sdOffset===0;document.getElementById('sdNext').disabled=sdBusy||!g_adminPw||sdOffset+sdPageSize>=sdCount;document.getElementById('sdUp').disabled=sdBusy||sdFolder==='/';}\n" \
    "async function sdRequest(path,options,extra){if(!g_adminPw)throw new Error('관리자 로그인이 필요합니다.');options=options||{};options.headers={'X-Admin-Password':g_adminPw};var r=await fetch(sdUrl(path,extra),options);if(!r.ok)throw new Error(await r.text());return r;}\n" \
    "async function sdRefresh(){if(sdBusy||!g_adminPw)return;sdBusy=true;sdControls();var body=document.getElementById('sdFiles');body.textContent='';try{var r=await sdRequest(sdFolder,{},'&offset='+sdOffset),d=await r.json();sdPageSize=d.page_size;sdCount=d.count;var free=Math.max(0,d.total-d.used),pct=d.total?Math.round(d.used/d.total*100):0;document.getElementById('sdCapacity').textContent='인식됨 · 사용 '+fmtB(d.used)+' / 전체 '+fmtB(d.total)+' · 남음 '+fmtB(free)+' ('+pct+'% 사용)';var bar=document.getElementById('sdUsageBar');bar.style.width=pct+'%';bar.setAttribute('aria-label','SD카드 '+pct+'% 사용');document.getElementById('sdFolder').textContent=sdFolder;document.getElementById('sdPage').textContent=sdCount?Math.floor(sdOffset/sdPageSize)+1+' / '+Math.ceil(sdCount/sdPageSize):'0개';d.files.forEach(function(f){var row=body.insertRow();row.insertCell().textContent=f.name;row.insertCell().textContent=f.directory?'폴더':fmtB(f.size);var cell=row.insertCell();function btn(label,action){var b=document.createElement('button');b.className='btn btn-s btn-sm';b.textContent=label;b.onclick=function(){if(!sdBusy)action();};cell.appendChild(b);}if(f.directory)btn('열기',function(){sdFolder=sdPath(f.name);sdOffset=0;sdRefresh();});else{btn('다운로드',function(){sdDownload(f.name);});btn('삭제',function(){sdDelete(f.name);});}});if(!d.files.length){var c=body.insertRow().insertCell();c.colSpan=3;c.textContent='파일이 없습니다.';}sdMessage('');}catch(e){document.getElementById('sdCapacity').textContent='SD 조회 실패 · 카드 인식 및 연결을 확인하세요.';document.getElementById('sdUsageBar').style.width='0%';sdMessage(uiErrorText(e));}finally{sdBusy=false;sdControls();}}\n" \
    "function sdParent(){if(sdBusy)return;sdFolder=sdFolder.slice(0,sdFolder.lastIndexOf('/'))||'/';sdOffset=0;sdRefresh();}\n" \
    "async function sdDownload(name){sdBusy=true;sdControls();sdMessage('다운로드 중: '+name);try{var r=await sdRequest(sdPath(name),{},'&action=download');var url=URL.createObjectURL(await r.blob()),a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(url);},60000);sdMessage('다운로드 완료: '+name);}catch(e){sdMessage(uiErrorText(e));}finally{sdBusy=false;sdControls();}}\n" \
    "async function sdDelete(name){if(!confirm(name+' 파일을 SD카드에서 삭제할까요?'))return;sdBusy=true;sdControls();try{await sdRequest(sdPath(name),{method:'DELETE'});sdOffset=0;sdBusy=false;await sdRefresh();sdMessage('삭제 완료: '+name);}catch(e){sdMessage(uiErrorText(e));}finally{sdBusy=false;sdControls();}}\n" \
    "function sdSend(file){return new Promise(function(resolve,reject){var xhr=new XMLHttpRequest();xhr.open('POST',sdUrl(sdPath(file.name)));xhr.timeout=180000;xhr.setRequestHeader('X-Admin-Password',g_adminPw);xhr.upload.onprogress=function(e){if(e.lengthComputable)document.getElementById('sdProgress').value=Math.round(e.loaded/e.total*100);};xhr.onload=function(){if(xhr.status>=200&&xhr.status<300)resolve();else reject(new Error(xhr.responseText||'업로드 실패'));};xhr.onerror=function(){reject(new Error('전송 연결이 끊겼습니다.'));};xhr.ontimeout=function(){reject(new Error('업로드 시간이 초과되었습니다.'));};xhr.send(file);});}\n" \
    "async function sdUpload(files){if(sdBusy||g_uploading||g_collecting||!files.length)return;sdBusy=true;g_uploading=true;sdControls();uploadControls(true);var done=0,err='';document.getElementById('sdProgress').style.display='block';try{for(var file of Array.from(files)){if(!file.size||file.size>8*1024*1024)throw new Error(file.name+': 1바이트~8 MiB 파일만 지원합니다.');sdMessage((done+1)+' / '+files.length+' 전송 중: '+file.name);document.getElementById('sdProgress').value=0;await sdSend(file);done++;}}catch(e){err=uiErrorText(e);}finally{sdBusy=false;g_uploading=false;uploadControls(false);document.getElementById('sdInput').value='';document.getElementById('sdProgress').style.display='none';await sdRefresh();sdMessage(done+'개 저장 완료'+(err?' · '+err:''));sdControls();}}\n" \
    "\n"
