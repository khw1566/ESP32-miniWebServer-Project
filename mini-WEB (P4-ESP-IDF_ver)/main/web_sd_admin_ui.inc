#define SD_ADMIN_HTML \
    "<style>#sdDropZone[aria-disabled=\"true\"]{opacity:.55;cursor:not-allowed}#sdDropZone:focus-visible{outline:2px solid var(--blue);outline-offset:3px}</style><div class=\"card\"><div class=\"card-hd\"><span>SD카드 파일 관리</span><button id=\"sdRefresh\" class=\"btn btn-s btn-sm\" onclick=\"sdRefresh()\">새로고침</button></div><div class=\"storage-summary\" id=\"sdCapacity\">로그인 후 SD카드를 조회합니다.</div><div class=\"pbar-bg\"><div id=\"sdUsageBar\" class=\"pbar-fill\" style=\"width:0%;background:var(--blue)\"></div></div><section class=\"storage-chart\" aria-label=\"SD카드 저장공간 구성\"><h3 style=\"font-size:14px;margin:0 0 14px\">사용 / 여유 공간 비율</h3><div style=\"display:flex;align-items:center;gap:22px;flex-wrap:wrap\"><div id=\"sdDonut\" role=\"img\" aria-label=\"SD카드 조회 대기\" style=\"width:144px;height:144px;flex-shrink:0;border-radius:50%;background:var(--line);display:grid;place-items:center\"><div style=\"width:104px;height:104px;border-radius:50%;background:var(--surface);display:flex;align-items:center;justify-content:center;flex-direction:column\"><span style=\"font-size:11px;color:var(--muted)\">전체 SD카드</span><b id=\"sdTotalLabel\" style=\"font-size:18px\">-</b></div></div><div id=\"sdLegend\" style=\"flex:1;min-width:180px;display:grid;gap:12px;font-size:12px\">로그인 후 SD카드를 조회합니다.</div></div><p class=\"storage-note\" style=\"margin:14px 0 0\">사용량은 파일시스템 관리 공간도 포함합니다. 비율은 SD카드 전체 용량 기준입니다.</p></section><div class=\"storage-toolbar\"><button class=\"btn btn-s btn-sm\" id=\"sdUp\" onclick=\"sdParent()\">상위 폴더</button><button class=\"btn btn-p btn-sm\" id=\"sdSelect\" onclick=\"sdChoose()\">파일 선택</button><input id=\"sdInput\" type=\"file\" multiple hidden onchange=\"sdUpload(this.files)\"></div><div class=\"storage-toolbar\"><span id=\"sdSelectedCount\" role=\"status\">0개 선택</span><button id=\"sdDownloadSelected\" class=\"btn btn-s btn-sm\" disabled onclick=\"sdBulk('download')\">선택 파일 저장</button><button id=\"sdDeleteSelected\" class=\"btn btn-r btn-sm\" disabled onclick=\"sdBulk('delete')\">선택 파일 삭제</button></div><div id=\"sdFolder\" class=\"storage-path\">/</div><p class=\"storage-note\">현재 폴더에 저장합니다. 파일당 최대 8 MiB이며 같은 이름은 덮어쓰지 않습니다. 웹페이지는 루트에 index.html, 이미지·영상·음악은 media 폴더에 넣으세요.</p><div id=\"sdDropZone\" class=\"dz\" role=\"button\" tabindex=\"0\" aria-label=\"SD카드 업로드 파일 선택\" aria-disabled=\"true\"><p><b>파일을 여기에 놓으세요</b></p><span>클릭하여 선택할 수도 있습니다. 현재 SD 폴더에 저장합니다.</span></div><progress id=\"sdProgress\" max=\"100\" value=\"0\" style=\"width:100%;display:none\"></progress><div id=\"sdMessage\" role=\"status\" aria-live=\"polite\" class=\"storage-status\"></div><div style=\"overflow-x:auto\"><table class=\"ft storage-table\"><thead><tr><th><input id=\"sdSelectAll\" type=\"checkbox\" aria-label=\"표시된 SD 파일 전체 선택\" onchange=\"sdSelectVisible(this.checked)\"></th><th>파일·폴더</th><th>용량</th><th>작업</th></tr></thead><tbody id=\"sdFiles\"></tbody></table></div><div class=\"storage-pages\"><button id=\"sdPrev\" class=\"btn btn-s btn-sm\" onclick=\"sdOffset=Math.max(0,sdOffset-sdPageSize);sdRefresh()\">이전</button><span id=\"sdPage\"></span><button id=\"sdNext\" class=\"btn btn-s btn-sm\" onclick=\"sdOffset+=sdPageSize;sdRefresh()\">다음</button></div></div>\n"
#define SD_ADMIN_SCRIPT \
    "function sdChoose(){if(sdBusy||fileBulkBusy||g_uploading||g_collecting)return;if(!g_adminPw&&!g_adminSession){sdMessage('관리자 로그인이 필요합니다.');return;}document.getElementById('sdInput').click();}\n" \
    "function sdChart(total,used){var chart=document.getElementById('sdDonut'),label=document.getElementById('sdTotalLabel'),legend=document.getElementById('sdLegend');legend.textContent='';if(!(total>0)){chart.style.background='var(--line)';chart.setAttribute('aria-label','SD카드 용량 조회 불가');label.textContent='-';legend.textContent='SD카드 용량을 조회할 수 없습니다.';return;}used=Math.max(0,Math.min(total,used));var pct=used/total*100;chart.style.background='conic-gradient(var(--blue) 0% '+pct+'%,var(--chart-free) '+pct+'% 100%)';label.textContent=fmtB(total);[['사용 공간',used,'var(--blue)'],['여유 공간',total-used,'var(--chart-free)']].forEach(function(r){var line=document.createElement('div');line.style.color='var(--text)';line.style.borderLeft='3px solid '+r[2];line.style.paddingLeft='8px';line.textContent=r[0]+' : '+fmtB(r[1])+' ('+(r[1]/total*100).toFixed(1)+'%)';legend.appendChild(line);});chart.setAttribute('aria-label','SD카드 사용 '+pct.toFixed(1)+'%, 여유 '+(100-pct).toFixed(1)+'%');}\n" \
    "var sdZone=document.getElementById('sdDropZone');sdZone.addEventListener('click',sdChoose);sdZone.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();sdChoose();}});['dragenter','dragover'].forEach(function(n){sdZone.addEventListener(n,function(e){e.preventDefault();if(!sdBusy&&!fileBulkBusy&&!g_uploading&&!g_collecting&&(g_adminPw||g_adminSession)){sdZone.classList.add('dv');if(e.dataTransfer)e.dataTransfer.dropEffect='copy';}});});['dragleave','drop'].forEach(function(n){sdZone.addEventListener(n,function(e){e.preventDefault();sdZone.classList.remove('dv');});});sdZone.addEventListener('drop',function(e){if(sdBusy||fileBulkBusy||g_uploading||g_collecting)return;if(!g_adminPw&&!g_adminSession){sdMessage('관리자 로그인이 필요합니다.');return;}var dt=e.dataTransfer;if(!dt)return;var items=Array.from(dt.items||[]);if(items.some(function(i){var entry=i.webkitGetAsEntry&&i.webkitGetAsEntry();return entry&&entry.isDirectory;})){sdMessage('폴더는 업로드할 수 없습니다. 폴더 안의 파일을 선택하세요.');return;}sdUpload(dt.files);});\n" \
    "\n" \
    "var sdFolder='/',sdOffset=0,sdPageSize=24,sdCount=0,sdBusy=false;\n" \
    "function sdUrl(path,extra){return '/api/sd/files?path='+encodeURIComponent(path)+(extra||'');}\n" \
    "function sdPath(name){return (sdFolder==='/'?'':sdFolder)+'/'+name;}\n" \
    "function sdMessage(text){document.getElementById('sdMessage').textContent=text;}\n" \
    "function sdControls(){var blocked=sdBusy||g_uploading||g_collecting||fileBulkBusy;var zone=document.getElementById('sdDropZone');zone.setAttribute('aria-disabled',String(blocked||(!g_adminPw&&!g_adminSession)));zone.setAttribute('aria-busy',String(blocked));if(blocked||(!g_adminPw&&!g_adminSession))zone.classList.remove('dv');['sdRefresh','sdSelect','sdUp','sdPrev','sdNext','sdInput'].forEach(function(id){document.getElementById(id).disabled=blocked||(!g_adminPw&&!g_adminSession);});document.getElementById('sdPrev').disabled=blocked||(!g_adminPw&&!g_adminSession)||sdOffset===0;document.getElementById('sdNext').disabled=blocked||(!g_adminPw&&!g_adminSession)||sdOffset+sdPageSize>=sdCount;document.getElementById('sdUp').disabled=blocked||(!g_adminPw&&!g_adminSession)||sdFolder==='/';sdSelectionControls();}\n" \
    "async function sdRequest(path,options,extra){if(!g_adminPw&&!g_adminSession)throw new Error('관리자 로그인이 필요합니다.');options=options||{};options.headers={'X-Admin-Password':g_adminPw};var r=await fetch(sdUrl(path,extra),options);if(!r.ok)throw new Error(await r.text());return r;}\n" \
    "async function sdRefresh(){if(sdBusy||g_uploading||g_collecting||fileBulkBusy||(!g_adminPw&&!g_adminSession))return;sdBusy=true;sdControls();var body=document.getElementById('sdFiles');body.textContent='';try{var r=await sdRequest(sdFolder,{},'&offset='+sdOffset),d=await r.json();sdPageSize=d.page_size;sdCount=d.count;if(sdOffset>=sdCount&&sdOffset>0){sdOffset=Math.max(0,Math.floor((sdCount-1)/sdPageSize)*sdPageSize);sdBusy=false;return await sdRefresh();}sdVisible=d.files;if(sdSelectionFolder!==sdFolder){sdSelection.clear();sdSelectionFolder=sdFolder;}var free=Math.max(0,d.total-d.used),pct=d.total?Math.round(d.used/d.total*100):0;document.getElementById('sdCapacity').textContent='인식됨 · 사용 '+fmtB(d.used)+' / 전체 '+fmtB(d.total)+' · 남음 '+fmtB(free)+' ('+pct+'% 사용)';var bar=document.getElementById('sdUsageBar');bar.style.width=pct+'%';sdChart(d.total,d.used);bar.setAttribute('aria-label','SD카드 '+pct+'% 사용');document.getElementById('sdFolder').textContent=sdFolder;document.getElementById('sdPage').textContent=sdCount?Math.floor(sdOffset/sdPageSize)+1+' / '+Math.ceil(sdCount/sdPageSize):'0개';d.files.forEach(function(f){var row=body.insertRow(),selectCell=row.insertCell();if(!f.directory){var check=document.createElement('input');check.type='checkbox';check.checked=sdSelection.has(f.name);check.setAttribute('aria-label',f.name+' 선택');check.onchange=function(){if(sdBusy||g_uploading||g_collecting){check.checked=sdSelection.has(f.name);return;}if(check.checked)sdSelection.add(f.name);else sdSelection.delete(f.name);sdSelectionControls();};selectCell.appendChild(check);}row.insertCell().textContent=f.name;row.insertCell().textContent=f.directory?'폴더':fmtB(f.size);var cell=row.insertCell();function btn(label,action){var b=document.createElement('button');b.className='btn btn-s btn-sm';b.textContent=label;b.onclick=function(){if(!sdBusy&&!fileBulkBusy&&!g_uploading&&!g_collecting)action();};cell.appendChild(b);}if(f.directory)btn('열기',function(){sdFolder=sdPath(f.name);sdOffset=0;sdRefresh();});else{if(f.size<=1024*1024&&/\\.(txt|html?|css|js|json|csv|md|log|xml|png|jpe?g|gif|webp)$/i.test(f.name))btn('내용 보기',function(){sdPreview(f.name);});btn('다운로드',function(){sdDownload(f.name);});btn('삭제',function(){sdDelete(f.name);});}});if(!d.files.length){var c=body.insertRow().insertCell();c.colSpan=4;c.textContent='파일이 없습니다.';}sdMessage(d.cached?'미리 조회한 파일 목록입니다.':'SD카드에서 파일 목록을 조회했습니다. 접속자가 없고 RAM 여유가 있으면 목록을 미리 조회합니다.');}catch(e){document.getElementById('sdCapacity').textContent='SD 조회 실패 · 카드 인식 및 연결을 확인하세요.';document.getElementById('sdUsageBar').style.width='0%';sdChart(0,0);document.getElementById('sdPage').textContent='';sdCount=0;sdVisible=[];sdMessage(uiErrorText(e));}finally{sdBusy=false;sdControls();}}\n" \
    "function sdParent(){if(sdBusy||fileBulkBusy||g_uploading||g_collecting)return;sdFolder=sdFolder.slice(0,sdFolder.lastIndexOf('/'))||'/';sdOffset=0;sdRefresh();}\n" \
    "async function sdDownload(name){if(sdBusy||g_uploading||g_collecting||fileBulkBusy)return;sdBusy=true;uploadControls(true);sdControls();sdMessage('다운로드 중: '+name);try{var r=await sdRequest(sdPath(name),{},'&action=download');var url=URL.createObjectURL(await r.blob()),a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(url);},60000);sdMessage('다운로드 완료: '+name);}catch(e){sdMessage(uiErrorText(e));}finally{sdBusy=false;uploadControls(false);sdControls();}}\n" \
    "async function sdDelete(name){if(sdBusy||fileBulkBusy||g_uploading||g_collecting||fileBulkBusy)return;if(!confirm(name+' 파일을 SD카드에서 삭제할까요?'))return;sdBusy=true;sdControls();try{await sdRequest(sdPath(name),{method:'DELETE'});sdOffset=0;sdBusy=false;await sdRefresh();sdMessage('삭제 완료: '+name);}catch(e){sdMessage(uiErrorText(e));}finally{sdBusy=false;sdControls();}}\n" \
    "function sdSend(file){return new Promise(function(resolve,reject){var xhr=new XMLHttpRequest();xhr.open('POST',sdUrl(sdPath(file.name)));xhr.timeout=180000;xhr.setRequestHeader('X-Admin-Password',g_adminPw);xhr.upload.onprogress=function(e){if(e.lengthComputable)document.getElementById('sdProgress').value=Math.round(e.loaded/e.total*100);};xhr.onload=function(){if(xhr.status>=200&&xhr.status<300)resolve();else reject(new Error(xhr.responseText||'업로드 실패'));};xhr.onerror=function(){reject(new Error('전송 연결이 끊겼습니다.'));};xhr.ontimeout=function(){reject(new Error('업로드 시간이 초과되었습니다.'));};xhr.send(file);});}\n" \
    "async function sdUpload(files){if(sdBusy||fileBulkBusy||g_uploading||g_collecting||!files||!files.length)return;if(!g_adminPw&&!g_adminSession){sdMessage('관리자 로그인이 필요합니다.');sdControls();return;}sdBusy=true;g_uploading=true;sdControls();uploadControls(true);var done=0,err='';document.getElementById('sdProgress').style.display='block';try{for(var file of Array.from(files)){if(!file.size||file.size>8*1024*1024)throw new Error(file.name+': 1바이트~8 MiB 파일만 지원합니다.');sdMessage((done+1)+' / '+files.length+' 전송 중: '+file.name);document.getElementById('sdProgress').value=0;await sdSend(file);done++;}}catch(e){err=uiErrorText(e);}finally{sdBusy=false;g_uploading=false;uploadControls(false);document.getElementById('sdInput').value='';document.getElementById('sdProgress').style.display='none';await sdRefresh();sdMessage(done+'개 저장 완료'+(err?' · '+err:''));sdControls();}}\n" \
