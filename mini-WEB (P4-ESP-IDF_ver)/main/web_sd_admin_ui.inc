    "\nvar sdSelection=new Set(),sdSelectionFolder='/',sdVisible=[];\nfunction sdSelectionControls(){if(sdSelectionFolder!==sdFolder){sdSelection.clear();sdSelectionFolder=sdFolder;}var eligible=sdVisible.filter(function(f){return !f.directory;}),n=eligible.filter(function(f){return sdSelection.has(f.name);}).length,all=document.getElementById('sdSelectAll');all.checked=!!eligible.length&&n===eligible.length;all.indeterminate=n>0&&n<eligible.length;all.disabled=sdBusy||fileBulkBusy||g_uploading||g_collecting||(!g_adminPw&&!g_adminSession)||!eligible.length;document.getElementById('sdSelectedCount').textContent=sdSelection.size+'개 선택';['sdDeleteSelected','sdDownloadSelected'].forEach(function(id){document.getElementById(id).disabled=sdBusy||fileBulkBusy||g_uploading||g_collecting||(!g_adminPw&&!g_adminSession)||!sdSelection.size;});}\nfunction sdSelectVisible(checked){if(sdBusy||fileBulkBusy||g_uploading||g_collecting)return;sdVisible.forEach(function(f){if(f.directory)return;if(checked)sdSelection.add(f.name);else sdSelection.delete(f.name);});sdRefresh();}\nasync function sdBulk(action){if(sdBusy||fileBulkBusy||g_uploading||g_collecting||(!g_adminPw&&!g_adminSession)||!sdSelection.size)return;var names=Array.from(sdSelection);if(action==='delete'&&!confirm(names.length+'개 파일을 SD카드에서 삭제할까요?'))return;sdBusy=true;uploadControls(true);sdControls();var done=0,errors=[];try{for(var name of names){sdMessage((done+1)+' / '+names.length+' 처리 중: '+name);try{if(action==='delete'){await sdRequest(sdPath(name),{method:'DELETE'});sdSelection.delete(name);}else await saveFileResponse(await sdRequest(sdPath(name),{},'&action=download'),name);done++;}catch(e){errors.push(name+': '+uiErrorText(e));}}}finally{sdBusy=false;uploadControls(false);if(action==='delete'){sdOffset=0;await sdRefresh();}sdControls();}sdMessage(done+'개 '+(action==='delete'?'삭제 완료':'다운로드 요청 완료')+(errors.length?' · 실패 '+errors.length+'개: '+errors.join(' / '):'')+(action==='download'?' · 브라우저에서 여러 파일 다운로드를 허용해야 할 수 있습니다.':''));}\n" \
    "async function sdPreview(name){if(sdBusy||fileBulkBusy||g_uploading||g_collecting)return;var win=window.open('about:blank','_blank');if(!win){sdMessage('내용을 보려면 팝업을 허용하세요.');return;}win.opener=null;sdBusy=true;sdControls();try{var r=await sdRequest(sdPath(name),{},'&action=preview'),blob=await r.blob(),ext=name.split('.').pop().toLowerCase(),types={png:'image/png',jpg:'image/jpeg',jpeg:'image/jpeg',gif:'image/gif',webp:'image/webp'},url=URL.createObjectURL(new Blob([blob],{type:types[ext]||'text/plain;charset=utf-8'}));win.location.href=url;setTimeout(function(){URL.revokeObjectURL(url);},60000);sdMessage('내용 보기: '+name);}catch(e){win.close();sdMessage(uiErrorText(e));}finally{sdBusy=false;sdControls();}}\n" \
